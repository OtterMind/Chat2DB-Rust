<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.chat2db.rust</groupId>
        <artifactId>chat2db-java</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>chat2db-compat-runtime</artifactId>
    <name>Chat2DB Compatibility Runtime</name>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <mainClass>ai.chat2db.rust.compat.CompatibilityRuntime</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>verify-executable-runtime</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <java jar="${project.build.directory}/${project.build.finalName}.jar"
                                      fork="true"
                                      failonerror="true"
                                      outputproperty="runtime.version.output">
                                    <arg value="--version"/>
                                </java>
                                <condition property="runtime.version.valid">
                                    <matches string="${runtime.version.output}"
                                             pattern="^chat2db-java-compat ${project.version} \(protocol 0\.1\)\s*$"/>
                                </condition>
                                <fail unless="runtime.version.valid"
                                      message="Packaged runtime did not publish the expected manifest version"/>

                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
